# Generate a unique token with: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
# Clear the token once the first administrator is set up.
AGENT007_SETUP_TOKEN=
# For a fresh, loopback-only local demo: AGENT007_AUTH=disabled
# For a shared HTTPS deployment: AGENT007_ALLOWED_HOSTS=agent.example.com
# Custom hostnames default to Secure cookies. Leave this unset for default behavior.
# AGENT007_SECURE_COOKIES=true

# Preview runs work with the following provider settings left blank.
AGENT007_PROVIDER=
AGENT007_MODEL=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=
MISTRAL_API_KEY=

# Optional local server overrides. Leave unset to retain Docker image defaults.
# HOST=127.0.0.1
# PORT=4387
# AGENT007_DATA_DIR=.agent007
